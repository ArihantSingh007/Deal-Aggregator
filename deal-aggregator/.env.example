# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/deal_aggregator?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string" # generate with: openssl rand -base64 32

# Google OAuth (optional — "Continue with Google" only appears on /login if these are set)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Rate limiting for login/registration (strongly recommended in production —
# without it, those endpoints have no brute-force/spam protection).
# Free tier: create a database at https://console.upstash.com > Redis, then
# copy the REST URL and token from its dashboard.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="DealLedger"

# Amazon Product Advertising API (PA-API 5.0)
# Sign up at https://affiliate-program.amazon.in > Tools > Product Advertising API
AMAZON_PAAPI_ACCESS_KEY=""
AMAZON_PAAPI_SECRET_KEY=""
AMAZON_PAAPI_PARTNER_TAG=""          # your Associates tracking ID, e.g. "yoursite-21"
AMAZON_PAAPI_HOST="webservices.amazon.in"
AMAZON_PAAPI_REGION="eu-west-1"      # correct region for the India marketplace

# Flipkart Affiliate API
# Apply at https://affiliate.flipkart.com > Account > API Access
FLIPKART_AFFILIATE_ID=""
FLIPKART_AFFILIATE_TOKEN=""
